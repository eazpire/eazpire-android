<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (fullBackupContent). Auth must never leave the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="eazpire_auth_prefs.xml" />
    <exclude domain="sharedpref" path="eazpire_auth_backup_v1.xml" />
    <exclude domain="sharedpref" path="oauth_pkce_pending.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
