<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="eazpire_auth_prefs.xml" />
        <exclude domain="sharedpref" path="eazpire_auth_backup_v1.xml" />
        <exclude domain="sharedpref" path="oauth_pkce_pending.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="eazpire_auth_prefs.xml" />
        <exclude domain="sharedpref" path="eazpire_auth_backup_v1.xml" />
        <exclude domain="sharedpref" path="oauth_pkce_pending.xml" />
    </device-transfer>
</data-extraction-rules>
